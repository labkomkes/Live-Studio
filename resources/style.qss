/* Live Studio - tema gelap bergaya OBS Studio + deck bergaya vMix */
QMainWindow, QDialog { background: #1e1e1e; }
QWidget { color: #e2e2e2; font-size: 12px; font-family: "Segoe UI", "Noto Sans", sans-serif; }
QToolTip { background: #111; color: #eee; border: 1px solid #555; padding: 4px; }

/* ---- menu ---- */
QMenuBar { background: #2b2b2b; border-bottom: 1px solid #3a3a3a; }
QMenuBar::item { padding: 5px 10px; background: transparent; }
QMenuBar::item:selected { background: #3d6db3; }
QMenu { background: #2b2b2b; border: 1px solid #444; padding: 2px; }
QMenu::item { padding: 5px 24px; }
QMenu::item:selected { background: #3d6db3; }
QMenu::separator { height: 1px; background: #444; margin: 3px 6px; }
QStatusBar { background: #2b2b2b; border-top: 1px solid #3a3a3a; color: #aaa; }

/* ---- monitor Preview / Program ---- */
QGroupBox { background: #161616; border: 1px solid #3a3a3a; margin-top: 12px; padding-top: 2px; font-weight: 700; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 5px; background: #1e1e1e; }
QGroupBox#previewBox { border: 1px solid #2f8f42; }
QGroupBox#previewBox::title { color: #4cd964; }
QGroupBox#programBox { border: 1px solid #c0392b; }
QGroupBox#programBox::title { color: #ff6b5e; }
QLabel#monitorName { color: #bdbdbd; font-weight: 600; padding: 1px; }

/* ---- tombol CUT / TAKE di tengah (gaya Studio Mode) ---- */
QPushButton#cutButton { background: #c77700; border: 1px solid #e59a1f; border-radius: 4px; font-size: 18px; font-weight: 800; color: #fff; }
QPushButton#cutButton:hover { background: #dd8a0a; }
QPushButton#cutButton:pressed { background: #a86400; }
QPushButton#takeButton { background: #c0392b; border: 1px solid #e4584a; border-radius: 4px; font-size: 22px; font-weight: 800; color: #fff; }
QPushButton#takeButton:hover { background: #d94a3b; }
QPushButton#takeButton:pressed { background: #a02f23; }

/* ---- panel gaya dock OBS ---- */
QFrame#panel { background: #262626; border: 1px solid #3a3a3a; }
QLabel#panelTitle { background: #333333; color: #d0d0d0; padding: 4px 8px; border-bottom: 1px solid #3a3a3a; font-weight: 600; }
QListWidget { background: #1a1a1a; border: 1px solid #333; outline: 0; }
QListWidget::item { padding: 4px 6px; }
QListWidget::item:hover { background: #2c2c2c; }
QListWidget::item:selected { background: #3d6db3; color: #fff; }
QTabWidget#toolsTabs::pane { background: #262626; border: 1px solid #3a3a3a; top: -1px; }
QTabBar::tab { background: #333; color: #c8c8c8; padding: 5px 14px; border: 1px solid #3a3a3a; border-bottom: 0; margin-right: 2px; }
QTabBar::tab:selected { background: #262626; color: #fff; }
QTabBar::tab:hover { background: #3c3c3c; }
QScrollArea { background: #262626; border: 0; }
QScrollArea > QWidget > QWidget { background: #262626; }

/* ---- kontrol umum ---- */
QPushButton, QToolButton { background: #3a3a3a; border: 1px solid #4b4b4b; border-radius: 3px; padding: 4px 10px; }
QPushButton:hover, QToolButton:hover { background: #484848; }
QPushButton:pressed, QToolButton:pressed { background: #2c2c2c; }
QPushButton:disabled, QToolButton:disabled { color: #777; background: #2e2e2e; }
QPushButton:checked, QToolButton:checked { background: #3d6db3; border-color: #5a8bd0; }
QToolButton::menu-indicator { image: none; width: 0; }
QPushButton#miniBtn, QToolButton#miniBtn { padding: 3px 8px; min-height: 18px; }
QPushButton#ltToggle[live="true"] { background: #c0392b; border-color: #e4584a; font-weight: 800; }
QLineEdit, QSpinBox, QComboBox, QPlainTextEdit { background: #1a1a1a; border: 1px solid #444; border-radius: 3px; padding: 3px 5px; selection-background-color: #3d6db3; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid #555; background: #1a1a1a; border-radius: 2px; }
QCheckBox::indicator:checked { background: #3d6db3; border-color: #5a8bd0; }
QSlider::groove:horizontal { height: 4px; background: #444; }
QSlider::handle:horizontal { background: #d0d0d0; width: 12px; margin: -5px 0; border-radius: 6px; }
QSlider::groove:vertical { width: 4px; background: #444; }
QSlider::handle:vertical { background: #d0d0d0; height: 12px; margin: 0 -5px; border-radius: 6px; }
QScrollBar:vertical { background: #1e1e1e; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #4a4a4a; min-height: 24px; border-radius: 4px; }
QScrollBar:horizontal { background: #1e1e1e; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: #4a4a4a; min-width: 24px; border-radius: 4px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }

/* ---- deck gaya vMix ---- */
QFrame#deck { background: #141414; border: 1px solid #3a3a3a; }
QFrame#deckSide { background: #232323; border-left: 1px solid #3a3a3a; }
QLabel#deckHeading { color: #9a9a9a; font-weight: 700; letter-spacing: 1px; }
QToolButton#transBtn { background: #353535; border: 1px solid #4b4b4b; padding: 7px 4px; font-weight: 600; }
QToolButton#transBtn:hover { background: #444; }
QToolButton#transBtn:checked { background: #3d6db3; border-color: #6a98dc; color: #fff; }
QPushButton#ltQuick, QToolButton#deckTool { padding: 7px 4px; font-weight: 600; }
QPushButton#ltQuick:checked { background: #c0392b; border-color: #e4584a; color: #fff; }

/* --- Status bar, rekam/siaran, pemutar video --- */
QStatusBar { background: #1b1b1b; color: #cfcfcf; }
QStatusBar::item { border: none; }
#statLabel { color: #9fb0c0; padding-right: 10px; }
#statusBtn { background: #2d2d2d; border: 1px solid #444; padding: 3px 10px; border-radius: 3px; }
#statusBtn:hover { background: #3a3a3a; }
#recButton, #liveButton { background: #2d2d2d; border: 1px solid #555; padding: 3px 12px; border-radius: 3px; font-weight: 600; }
#recButton:hover, #liveButton:hover { background: #3c3c3c; }
#recButton[active="true"] { background: #b32b2b; border-color: #e55; color: white; }
#liveButton[active="true"] { background: #1f7a3a; border-color: #4c8; color: white; }
#mediaBtn { font-size: 15px; padding: 3px 0; }
#mediaTime { font-family: Consolas, monospace; color: #dcdcdc; }
#mediaSeek::groove:horizontal { height: 6px; background: #3a3a3a; border-radius: 3px; }
#mediaSeek::sub-page:horizontal { background: #3b82f6; border-radius: 3px; }
#mediaSeek::handle:horizontal { width: 14px; margin: -5px 0; background: #e8e8e8; border-radius: 7px; }
#monitorBtn:checked { background: #1f6fb3; color: white; }

#include <winver.h>

IDI_ICON1 ICON "livestudio.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    LIVESTUDIO_VER_MAJOR,LIVESTUDIO_VER_MINOR,LIVESTUDIO_VER_PATCH,0
 PRODUCTVERSION LIVESTUDIO_VER_MAJOR,LIVESTUDIO_VER_MINOR,LIVESTUDIO_VER_PATCH,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Live Studio\0"
            VALUE "FileDescription",  "Live Studio - produksi live berbasis libobs\0"
            VALUE "FileVersion",      LIVESTUDIO_VERSION_STR "\0"
            VALUE "InternalName",     "LiveStudio\0"
            VALUE "OriginalFilename", "LiveStudio.exe\0"
            VALUE "ProductName",      "Live Studio\0"
            VALUE "ProductVersion",   LIVESTUDIO_VERSION_STR "\0"
            VALUE "LegalCopyright",   "GPL-2.0-or-later (menggunakan libobs)\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
